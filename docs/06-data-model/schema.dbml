Enum product_version_status { VERIFIED UNCERTAIN RETIRED }
Enum job_status { QUEUED RUNNING SUCCEEDED FAILED }
Enum assessment_kind { FINAL EARLY }
Enum assessment_outcome { NO_DISCOMFORT DISCOMFORT NEED_MORE_TIME UNKNOWN }
Enum evidence_relation { SUPPORT OPPOSE UNCERTAIN }

Table app_user {
  id integer [pk, increment]
  email text [not null, unique]
  password_hash text [not null]
  timezone text [not null, default: 'Asia/Seoul']
  current_routine_version_id integer
  write_locked_at datetime
  created_at datetime [not null]
}

Table ai_memory {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  source_type text [not null]
  original_text text [not null]
  summary_text text [not null]
  deleted_at datetime
  updated_at datetime [not null]
}

Table brand {
  id integer [pk, increment]
  name_ko text [not null, unique]
  official_url text
}

Table product {
  id integer [pk, increment]
  brand_id integer [not null, ref: > brand.id]
  canonical_name text [not null]
  category text [not null, note: 'SKINCARE, CLEANSING, SUNCARE']
}

Table product_version {
  id integer [pk, increment]
  product_id integer [not null, ref: > product.id]
  display_name text [not null]
  volume_option text
  market text [not null, default: 'KR']
  package_clue text
  sold_from date
  sold_to date
  status product_version_status [not null]
  verified_at datetime
}

Table evidence_source {
  id integer [pk, increment]
  source_type text [not null, note: 'BRAND, REGULATOR, OFFICIAL_DB, PAPER']
  title text [not null]
  organization text [not null]
  published_at date
  url text [not null]
  checked_at datetime [not null]
}

Table product_fact {
  id integer [pk, increment]
  product_version_id integer [not null, ref: > product_version.id]
  fact_type text [not null, note: 'DIRECTIONS, CLAIM, TEXTURE, CAUTION']
  value_text text [not null]
  source_id integer [not null, ref: > evidence_source.id]
  checked_at datetime [not null]
}

Table ingredient {
  id integer [pk, increment]
  canonical_name text [not null, unique]
  inci_name text
  korean_name text
}

Table ingredient_label {
  id integer [pk, increment]
  product_version_id integer [not null, ref: > product_version.id]
  ingredient_id integer [ref: > ingredient.id]
  display_order integer [not null]
  label_text text [not null]
  source_id integer [not null, ref: > evidence_source.id]
}

Table price_snapshot {
  id integer [pk, increment]
  product_version_id integer [not null, ref: > product_version.id]
  retailer text [not null]
  price_krw integer [not null]
  url text
  checked_at datetime [not null]
}

Table catalog_review_request {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  query_text text [not null]
  status text [not null, default: 'RECEIVED']
  created_at datetime [not null]
}

Table user_product {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  product_version_id integer [ref: > product_version.id]
  entered_name text
  state text [not null, default: 'UNUSED']
  registered_at datetime [not null]
  deleted_at datetime
}

Table product_memo {
  id integer [pk, increment]
  user_product_id integer [not null, ref: > user_product.id]
  user_id integer [not null, ref: > app_user.id]
  text text [not null]
  created_at datetime [not null]
  superseded_at datetime
}

Table wishlist_item {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  product_version_id integer [not null, ref: > product_version.id]
  converted_user_product_id integer [ref: > user_product.id]
  created_at datetime [not null]

  indexes { (user_id, product_version_id) [unique] }
}

Table routine_version {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  version_no integer [not null]
  source_type text [not null, note: 'USER_EDIT, RESCUE_PLAN']
  source_rescue_plan_id integer
  is_current boolean [not null, default: false]
  started_local_date date [not null]
  timezone text [not null]
  assessment_due_at datetime [not null]
  created_at datetime [not null]

  indexes { (user_id, version_no) [unique] }
}

Table routine_item {
  id integer [pk, increment]
  routine_version_id integer [not null, ref: > routine_version.id]
  user_product_id integer [not null, ref: > user_product.id]
  period text [not null, note: 'MORNING, EVENING']
  position integer [not null]
  frequency_text text

  indexes { (routine_version_id, period, position) [unique] }
}

Table routine_assessment {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  routine_version_id integer [not null, ref: > routine_version.id]
  kind assessment_kind [not null]
  actual_use_matched boolean
  outcome assessment_outcome [not null]
  response_text text
  confidence_weight real [not null]
  assessed_at datetime [not null]
  next_due_at datetime

  indexes { (routine_version_id, kind) [unique] }
}

Table stable_routine_pointer {
  user_id integer [pk, ref: > app_user.id]
  routine_version_id integer [not null, ref: > routine_version.id]
  assessment_id integer [not null, ref: > routine_assessment.id]
  promoted_at datetime [not null]
}

Table rescue_case {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  start_routine_version_id integer [ref: > routine_version.id]
  stable_routine_version_id integer [ref: > routine_version.id]
  status text [not null]
  safety_boundary_reached boolean [not null, default: false]
  final_action text
  created_at datetime [not null]
  closed_at datetime
}

Table rescue_message {
  id integer [pk, increment]
  rescue_case_id integer [not null, ref: > rescue_case.id]
  sequence_no integer [not null]
  role text [not null, note: 'USER, ASSISTANT']
  content text [not null]
  structured_json text
  created_at datetime [not null]

  indexes { (rescue_case_id, sequence_no) [unique] }
}

Table rescue_change {
  id integer [pk, increment]
  rescue_case_id integer [not null, ref: > rescue_case.id]
  change_type text [not null]
  user_product_id integer [ref: > user_product.id]
  before_json text
  after_json text
  user_confirmed boolean [not null, default: false]
}

Table rescue_plan {
  id integer [pk, increment]
  rescue_case_id integer [not null, unique, ref: > rescue_case.id]
  plan_json text [not null]
  validation_status text [not null]
  applied_routine_version_id integer [ref: > routine_version.id]
  created_at datetime [not null]
}

Table analysis {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  type text [not null, note: 'OPINION, RECOMMENDATION, ROUTINE, RESCUE, PRODUCT']
  subject_ref text
  input_snapshot_json text [not null]
  output_json text
  model text
  prompt_version text [not null]
  validation_status text [not null]
  created_at datetime [not null]
}

Table analysis_evidence {
  id integer [pk, increment]
  analysis_id integer [not null, ref: > analysis.id]
  claim_key text [not null]
  relation evidence_relation [not null]
  source_id integer [ref: > evidence_source.id]
  personal_record_type text
  personal_record_id integer
  summary text [not null]
}

Table ai_job {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  job_type text [not null]
  input_hash text [not null]
  status job_status [not null]
  analysis_id integer [ref: > analysis.id]
  retry_of_job_id integer [ref: > ai_job.id]
  error_code text
  created_at datetime [not null]
  finished_at datetime
}

Table notification {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  type text [not null]
  target_type text [not null]
  target_id integer [not null]
  dedupe_key text [not null, unique]
  due_at datetime [not null]
  read_at datetime
}

Table receipt_upload {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  object_key text [not null]
  status text [not null]
  ai_job_id integer [ref: > ai_job.id]
  created_at datetime [not null]
}

Table receipt_item {
  id integer [pk, increment]
  receipt_upload_id integer [not null, ref: > receipt_upload.id]
  line_no integer [not null]
  raw_text text [not null]
  candidate_json text
  confirmed_product_version_id integer [ref: > product_version.id]
  created_user_product_id integer [ref: > user_product.id]
}
