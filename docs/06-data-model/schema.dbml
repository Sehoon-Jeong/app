// SQLite Flyway DDL의 사람이 읽는 관계 계약이다.
// DBML enum은 실제 migration에서 TEXT + CHECK로 구현한다.

Enum product_verification_status {
  UNVERIFIED
  VERIFIED
  CONFLICTED
}

Enum product_lifecycle_status {
  ACTIVE
  DISCONTINUED
  UNKNOWN
}

Enum ai_memory_source_type {
  ONBOARDING
  CONVERSATION
  USER_EDIT
}

Enum product_category {
  SKINCARE
  CLEANSING
  SUNCARE
}

Enum evidence_source_type {
  BRAND
  REGULATOR
  OFFICIAL_DB
  PAPER
}

Enum product_fact_type {
  DIRECTIONS
  CLAIM
  TEXTURE
  CAUTION
}

Enum ingredient_extraction_status {
  PENDING
  EXTRACTED
  VERIFIED
  FAILED
}

Enum catalog_review_status {
  RECEIVED
  REVIEWING
  RESOLVED
  REJECTED
}

Enum routine_status {
  DRAFT
  ACTIVE
  SUPERSEDED
  CANCELLED
}

Enum routine_source_type {
  USER_EDIT
  RESCUE_PLAN
}

Enum routine_period {
  MORNING
  EVENING
}

Enum routine_frequency_mode {
  DAILY
  DAYS_PER_WEEK
  AS_NEEDED
  CUSTOM
}

Enum experience_review_schedule_status {
  SCHEDULED
  COMPLETED
  CANCELLED
  MISSED
}

Enum adherence_status {
  MATCHED
  PARTIAL
  MISMATCHED
  UNKNOWN
}

Enum experience_sentiment {
  LIKED
  DISAPPOINTED
  UNKNOWN
}

Enum discomfort_status {
  NONE_REPORTED
  REPORTED
  UNKNOWN
}

Enum experience_source_type {
  IN_USE
  DAY_7_REVIEW
  PRODUCT_NOTE
  RESCUE
}

Enum pattern_status {
  CANDIDATE
  ACTIVE
  SUPERSEDED
  REJECTED
}

Enum pattern_feedback_type {
  RELEVANT
  NOT_RELEVANT
  UNSURE
}

Enum evidence_relation {
  SUPPORT
  OPPOSE
  UNCERTAIN
}

Enum analysis_request_status {
  PENDING
  RUNNING
  READY
  FAILED
  STALE
}

Enum analysis_run_status {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

Enum validation_status {
  PENDING
  VALID
  INVALID
}

Enum job_status {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

Enum rescue_case_status {
  CONVERSATION
  ANALYZING
  READY
  CLOSED
}

Enum rescue_plan_status {
  GENERATED
  VALIDATED
  CONFIRMED
  APPLIED
  STALE
  REJECTED
}

Enum rescue_final_action {
  APPLIED
  APPLIED_EDITED
  RECORD_ONLY
}

Enum routine_change_type {
  PRODUCT_ADDED
  PRODUCT_REMOVED
  ORDER_CHANGED
  FREQUENCY_CHANGED
  PERIOD_CHANGED
}

Enum message_role {
  USER
  ASSISTANT
}

Enum safety_detector_type {
  USER_SELF_REPORT
  FIXED_RULE
  AI_CLASSIFIER
}

Enum safety_action {
  STOP_PRODUCT_RANKING_AND_GUIDE_TO_PROFESSIONAL
}

Enum analysis_type {
  EXPERIENCE_EXTRACTION
  PATTERN_DISCOVERY
  PRODUCT_EXPLORATION
  PRODUCT_RESEARCH
  ROUTINE_ORDER
  ROUTINE_ANALYSIS
  RESCUE
  RECEIPT_OCR
}

Enum conversation_kind {
  GENERAL
  PRODUCT_EXPLORATION
  PATTERN
  RESCUE
  PRODUCT_RESEARCH
}

Enum conversation_status {
  OPEN
  CLOSED
}

Enum ai_job_type {
  RECEIPT_OCR
  EXPERIENCE_EXTRACTION
  PATTERN_DISCOVERY
  PRODUCT_EXPLORATION
  PRODUCT_RESEARCH
  ROUTINE_ANALYSIS
  ROUTINE_ORDER
  RESCUE
  ACCOUNT_DELETE
}

Enum notification_status {
  SCHEDULED
  SENT
  CANCELLED
}

Enum notification_type {
  EXPERIENCE_REVIEW_DUE
  AI_JOB_SUCCEEDED
  AI_JOB_FAILED
}

Enum receipt_status {
  QUEUED
  RUNNING
  NEEDS_CONFIRMATION
  CONFIRMED
  FAILED
}

Table app_user {
  id integer [pk, increment]
  email text [not null, unique, note: 'trim 후 소문자로 정규화한 로그인 이메일']
  password_hash text [not null]
  timezone text [not null, default: 'Asia/Seoul']
  onboarding_complete boolean [not null, default: false]
  created_at text [not null, note: 'UTC ISO 8601']
  deletion_requested_at text [note: 'UTC ISO 8601']
}

Table ai_memory {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  source_type ai_memory_source_type [not null]
  source_conversation_message_id integer
  original_text text [not null]
  summary_text text [not null]
  created_by_analysis_run_id integer
  deleted_at text [note: 'UTC ISO 8601']
  updated_at text [not null, note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (user_id, updated_at)
  }
}

Table idempotency_record {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  operation text [not null]
  idempotency_key text [not null]
  request_hash text [not null]
  response_status integer [not null]
  resource_type text
  resource_id integer
  created_at text [not null, note: 'UTC ISO 8601']
  expires_at text [not null, note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (user_id, operation, idempotency_key) [unique]
    (expires_at)
  }
}

Table brand {
  id integer [pk, increment]
  name_ko text [not null, unique]
  official_url text
}

Table product {
  id integer [pk, increment]
  brand_id integer [not null, ref: > brand.id]
  canonical_name text [not null]
  category product_category [not null]

  indexes {
    (brand_id, canonical_name) [unique]
  }
}

Table product_version {
  id integer [pk, increment]
  product_id integer [not null, ref: > product.id]
  display_name text [not null]
  volume_option text
  market text [not null, default: 'KR']
  package_clue text
  sold_from text [note: 'YYYY-MM-DD']
  sold_to text [note: 'YYYY-MM-DD']
  verification_status product_verification_status [not null, default: 'UNVERIFIED']
  lifecycle_status product_lifecycle_status [not null, default: 'UNKNOWN']
  catalog_revision integer [not null, default: 1]
  verified_by text
  verification_method text
  verification_note text
  verified_at text [note: 'UTC ISO 8601']

  indexes {
    (product_id, market, display_name)
    (verification_status, lifecycle_status)
  }
}

Table evidence_source {
  id integer [pk, increment]
  source_type evidence_source_type [not null]
  organization text [not null]
  canonical_url text [not null, unique]
  created_at text [not null, note: 'UTC ISO 8601']
}

Table evidence_snapshot {
  id integer [pk, increment]
  source_id integer [not null, ref: > evidence_source.id]
  title text [not null]
  published_at text [note: 'YYYY-MM-DD']
  retrieved_at text [not null, note: 'UTC ISO 8601']
  content_hash text [not null]
  object_key text [note: '보존 권한이 있는 원문 또는 추출물 객체']
  excerpt_text text [note: '판단에 실제 사용한 최소 인용 범위']

  indexes {
    (source_id, content_hash) [unique]
    (source_id, retrieved_at)
  }
}

Table product_fact {
  id integer [pk, increment]
  product_version_id integer [not null, ref: > product_version.id]
  fact_type product_fact_type [not null]
  value_text text [not null]
  created_at text [not null, note: 'UTC ISO 8601']

  indexes {
    (product_version_id, fact_type)
  }
}

Table product_fact_evidence {
  product_fact_id integer [not null, ref: > product_fact.id]
  evidence_snapshot_id integer [not null, ref: > evidence_snapshot.id]
  relation evidence_relation [not null, default: 'SUPPORT']

  indexes {
    (product_fact_id, evidence_snapshot_id) [pk]
    (evidence_snapshot_id)
  }
}

Table ingredient {
  id integer [pk, increment]
  canonical_name text [not null, unique]
  inci_name text
  korean_name text
}

Table ingredient_list {
  id integer [pk, increment]
  product_version_id integer [not null, ref: > product_version.id]
  evidence_snapshot_id integer [not null, ref: > evidence_snapshot.id]
  raw_text text [not null]
  extraction_status ingredient_extraction_status [not null]
  extraction_model text
  extraction_schema_version text [not null]
  created_at text [not null, note: 'UTC ISO 8601']

  indexes {
    (product_version_id, created_at)
    (evidence_snapshot_id)
  }
}

Table ingredient_list_item {
  id integer [pk, increment]
  ingredient_list_id integer [not null, ref: > ingredient_list.id]
  display_order integer [not null, note: '1 이상']
  label_text text [not null]
  ingredient_id integer [ref: > ingredient.id]

  indexes {
    (ingredient_list_id, display_order) [unique]
    (ingredient_id)
  }
}

Table price_snapshot {
  id integer [pk, increment]
  product_version_id integer [not null, ref: > product_version.id]
  retailer text [not null]
  amount_minor integer [not null, note: '0 이상, KRW는 원 단위']
  currency text [not null, default: 'KRW']
  url text
  checked_at text [not null, note: 'UTC ISO 8601']

  indexes {
    (product_version_id, checked_at)
  }
}

Table user_product {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  product_version_id integer [ref: > product_version.id]
  entered_name text
  registered_at text [not null, note: 'UTC ISO 8601']
  deleted_at text [note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (id, user_id, product_version_id) [unique]
    (user_id, registered_at)
    (product_version_id)
  }
}

Table product_memo {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  user_product_id integer [not null]
  revision_no integer [not null]
  supersedes_memo_id integer
  text text [not null]
  created_at text [not null, note: 'UTC ISO 8601']
  superseded_at text [note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (id, user_id, user_product_id) [unique]
    (user_product_id, revision_no) [unique]
    (user_id, user_product_id, superseded_at)
  }
}

Table wishlist_item {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  product_version_id integer [not null, ref: > product_version.id]
  converted_user_product_id integer
  created_at text [not null, note: 'UTC ISO 8601']
  converted_at text [note: 'UTC ISO 8601']
  removed_at text [note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (user_id, product_version_id, created_at)
  }
}

Table routine_version {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  version_no integer [not null]
  based_on_routine_version_id integer
  source_type routine_source_type [not null]
  source_rescue_plan_id integer
  status routine_status [not null]
  started_local_date text [not null, note: 'YYYY-MM-DD']
  timezone text [not null]
  activated_at text [note: 'UTC ISO 8601']
  ended_at text [note: 'UTC ISO 8601']
  created_at text [not null, note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (user_id, version_no) [unique]
    (user_id, status)
  }
}

Table routine_item {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  routine_version_id integer [not null]
  user_product_id integer [not null]
  period routine_period [not null]
  position integer [not null, note: '1 이상']
  frequency_mode routine_frequency_mode [not null]
  frequency_days_per_week integer [note: 'DAYS_PER_WEEK일 때 1~6']
  frequency_text text [note: '사용자 표시 원문, 최대 100자']

  indexes {
    (id, user_id) [unique]
    (routine_version_id, period, position) [unique]
    (routine_version_id, period, user_product_id) [unique]
    (user_product_id)
  }
}

Table experience_review_schedule {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  routine_version_id integer [not null]
  sequence_no integer [not null, note: '최초 1, 연장마다 증가']
  due_at text [not null, note: 'UTC ISO 8601']
  status experience_review_schedule_status [not null]
  completed_experience_record_id integer
  completed_at text [note: 'UTC ISO 8601']
  created_at text [not null, note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (id, user_id, routine_version_id) [unique]
    (routine_version_id, sequence_no) [unique]
    (user_id, status, due_at)
  }
}

Table experience_record {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  routine_version_id integer [not null]
  review_schedule_id integer [unique]
  user_product_id integer
  source_type experience_source_type [not null]
  adherence adherence_status [not null]
  sentiment experience_sentiment [not null]
  discomfort discomfort_status [not null]
  original_text text
  original_text_revision_no integer [not null, default: 1]
  recorded_at text [not null, note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (id, user_id, routine_version_id) [unique]
    (id, user_id, user_product_id) [unique]
    (user_id, recorded_at)
    (user_product_id, recorded_at)
    (routine_version_id, recorded_at)
  }
}

Table experience_observation {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  experience_record_id integer [not null]
  observation_key text [not null, note: 'AI schema의 열린 문자열 key']
  observation_text text [not null]
  source_span text [not null, note: '사용자 원문에서 대응하는 표현']
  polarity text [not null, note: 'POSITIVE, NEGATIVE, NEUTRAL, UNKNOWN']
  analysis_run_id integer [not null]
  schema_version text [not null]
  created_at text [not null, note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (experience_record_id, observation_key)
    (analysis_run_id)
  }
}

Table comparison_baseline_period {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  routine_version_id integer [not null]
  confirmed_by_experience_record_id integer [not null]
  started_at text [not null, note: 'UTC ISO 8601']
  ended_at text [note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (user_id, started_at)
    (routine_version_id)
  }
}

Table personal_pattern {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  pattern_key text [not null]
  revision_no integer [not null]
  status pattern_status [not null]
  statement text [not null]
  uncertainty_text text
  supporting_record_count integer [not null]
  opposing_record_count integer [not null]
  analysis_run_id integer [not null]
  created_at text [not null, note: 'UTC ISO 8601']
  superseded_at text [note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (user_id, pattern_key, revision_no) [unique]
    (user_id, status, created_at)
  }
}

Table pattern_evidence {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  personal_pattern_id integer [not null]
  experience_record_id integer [not null]
  relation evidence_relation [not null]
  explanation text [not null]

  indexes {
    (personal_pattern_id, experience_record_id) [unique]
    (experience_record_id)
  }
}

Table pattern_feedback {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  personal_pattern_id integer [not null]
  feedback pattern_feedback_type [not null]
  created_at text [not null, note: 'UTC ISO 8601']

  indexes {
    (personal_pattern_id, user_id) [unique]
  }
}

Table rescue_case {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  source_experience_record_id integer
  start_routine_version_id integer
  comparison_baseline_routine_version_id integer
  status rescue_case_status [not null]
  final_action rescue_final_action
  created_at text [not null, note: 'UTC ISO 8601']
  closed_at text [note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (user_id, status, created_at)
  }
}

Table rescue_message {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  rescue_case_id integer [not null]
  sequence_no integer [not null]
  role message_role [not null]
  content text [not null]
  structured_json text [note: 'SQLite JSON text']
  structured_schema_version text
  analysis_run_id integer
  created_at text [not null, note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (id, user_id, rescue_case_id) [unique]
    (rescue_case_id, sequence_no) [unique]
  }
}

Table rescue_safety_event {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  rescue_case_id integer [not null]
  source_message_id integer [not null]
  boundary_code text [not null]
  detector_type safety_detector_type [not null]
  detector_version text [not null]
  action safety_action [not null]
  detail_json text [note: 'SQLite JSON text']
  detail_schema_version text
  detected_at text [not null, note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (rescue_case_id, detected_at)
  }
}

Table rescue_plan {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  rescue_case_id integer [not null]
  version_no integer [not null]
  analysis_run_id integer [not null]
  base_routine_version_id integer
  plan_json text [not null, note: 'SQLite JSON text']
  plan_schema_version text [not null]
  validation_status validation_status [not null]
  status rescue_plan_status [not null]
  confirmed_at text [note: 'UTC ISO 8601']
  applied_at text [note: 'UTC ISO 8601']
  applied_routine_version_id integer
  created_at text [not null, note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (rescue_case_id, version_no) [unique]
    (rescue_case_id, status)
  }
}

Table rescue_change {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  rescue_plan_id integer [not null]
  sequence_no integer [not null]
  change_type routine_change_type [not null]
  user_product_id integer
  before_json text [note: 'SQLite JSON text']
  after_json text [note: 'SQLite JSON text']
  change_schema_version text [not null]
  user_confirmed boolean [not null, default: false]
  created_at text [not null, note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (rescue_plan_id, sequence_no) [unique]
    (user_product_id)
  }
}

Table analysis_request {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  type analysis_type [not null]
  subject_type text
  subject_id integer
  input_snapshot_json text [not null, note: 'SQLite JSON text']
  input_schema_version text [not null]
  input_hash text [not null]
  status analysis_request_status [not null]
  selected_run_id integer
  created_at text [not null, note: 'UTC ISO 8601']
  completed_at text [note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (user_id, type, created_at)
    (user_id, type, input_hash)
  }
}

Table analysis_run {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  analysis_request_id integer [not null]
  attempt_no integer [not null]
  status analysis_run_status [not null]
  model text [not null]
  prompt_version text [not null]
  output_json text [note: 'SQLite JSON text, 공급자 원본 envelope']
  output_schema_version text [not null]
  validation_status validation_status [not null]
  validation_error_json text [note: 'SQLite JSON text']
  error_code text
  input_tokens integer
  output_tokens integer
  started_at text [note: 'UTC ISO 8601']
  finished_at text [note: 'UTC ISO 8601']
  created_at text [not null, note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (id, user_id, analysis_request_id) [unique]
    (analysis_request_id, attempt_no) [unique]
    (user_id, created_at)
  }
}

Table conversation {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  kind conversation_kind [not null]
  root_analysis_request_id integer [not null]
  status conversation_status [not null]
  created_at text [not null, note: 'UTC ISO 8601']
  closed_at text [note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (user_id, status, created_at)
  }
}

Table conversation_message {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  conversation_id integer [not null]
  sequence_no integer [not null]
  role message_role [not null]
  content text [not null]
  analysis_run_id integer
  created_at text [not null, note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (id, user_id, conversation_id) [unique]
    (conversation_id, sequence_no) [unique]
  }
}

Table analysis_evidence {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  analysis_run_id integer [not null]
  claim_key text [not null]
  relation evidence_relation [not null]
  evidence_snapshot_id integer [ref: > evidence_snapshot.id]
  experience_record_id integer
  personal_pattern_id integer
  rescue_case_id integer
  ai_memory_id integer
  summary text [not null]

  indexes {
    (analysis_run_id, claim_key)
    (evidence_snapshot_id)
    (experience_record_id)
    (personal_pattern_id)
    (rescue_case_id)
    (ai_memory_id)
  }
}

Table ai_job {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  job_type ai_job_type [not null]
  input_hash text [not null]
  status job_status [not null]
  analysis_request_id integer
  analysis_run_id integer
  retry_of_job_id integer
  attempt_no integer [not null, default: 1]
  available_at text [not null, note: 'UTC ISO 8601']
  locked_by text
  locked_until text [note: 'UTC ISO 8601']
  heartbeat_at text [note: 'UTC ISO 8601']
  error_code text
  created_at text [not null, note: 'UTC ISO 8601']
  started_at text [note: 'UTC ISO 8601']
  finished_at text [note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (user_id, job_type, input_hash)
    (status, available_at)
    (locked_until)
  }
}

Table notification {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  type notification_type [not null]
  experience_review_schedule_id integer
  ai_job_id integer
  title text [not null]
  body text
  dedupe_key text [not null]
  due_at text [not null, note: 'UTC ISO 8601, 전달 예약 시각']
  status notification_status [not null]
  sent_at text [note: 'UTC ISO 8601']
  read_at text [note: 'UTC ISO 8601']
  cancelled_at text [note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (user_id, dedupe_key) [unique]
    (status, due_at)
  }
}

Table receipt_upload {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  object_key text [not null]
  status receipt_status [not null]
  ai_job_id integer
  created_at text [not null, note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (user_id, created_at)
  }
}

Table receipt_item {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  receipt_upload_id integer [not null]
  line_no integer [not null, note: '1 이상']
  raw_text text [not null]
  candidate_json text [note: 'SQLite JSON text']
  candidate_schema_version text [not null]
  confirmed_product_version_id integer [ref: > product_version.id]
  created_user_product_id integer

  indexes {
    (id, user_id) [unique]
    (receipt_upload_id, line_no) [unique]
    (confirmed_product_version_id)
  }
}

Table catalog_review_request {
  id integer [pk, increment]
  user_id integer [not null, ref: > app_user.id]
  query_text text [not null]
  user_product_id integer
  receipt_item_id integer
  status catalog_review_status [not null]
  resolved_product_version_id integer [ref: > product_version.id]
  created_at text [not null, note: 'UTC ISO 8601']
  handled_at text [note: 'UTC ISO 8601']

  indexes {
    (id, user_id) [unique]
    (user_id, status, created_at)
  }
}

// 개인 데이터 복합 FK: 존재뿐 아니라 같은 사용자 소유인지 확인한다.
Ref: product_memo.(user_product_id, user_id) > user_product.(id, user_id)
Ref: product_memo.(supersedes_memo_id, user_id, user_product_id) > product_memo.(id, user_id, user_product_id)
Ref: wishlist_item.(converted_user_product_id, user_id, product_version_id) > user_product.(id, user_id, product_version_id)

Ref: routine_version.(based_on_routine_version_id, user_id) > routine_version.(id, user_id)
Ref: routine_item.(routine_version_id, user_id) > routine_version.(id, user_id)
Ref: routine_item.(user_product_id, user_id) > user_product.(id, user_id)

Ref: experience_review_schedule.(routine_version_id, user_id) > routine_version.(id, user_id)
Ref: experience_review_schedule.(completed_experience_record_id, user_id, routine_version_id) > experience_record.(id, user_id, routine_version_id)
Ref: experience_record.(routine_version_id, user_id) > routine_version.(id, user_id)
Ref: experience_record.(user_product_id, user_id) > user_product.(id, user_id)
Ref: experience_record.(review_schedule_id, user_id, routine_version_id) > experience_review_schedule.(id, user_id, routine_version_id)
Ref: experience_observation.(experience_record_id, user_id) > experience_record.(id, user_id)
Ref: experience_observation.(analysis_run_id, user_id) > analysis_run.(id, user_id)
Ref: comparison_baseline_period.(routine_version_id, user_id) > routine_version.(id, user_id)
Ref: comparison_baseline_period.(confirmed_by_experience_record_id, user_id, routine_version_id) > experience_record.(id, user_id, routine_version_id)
Ref: personal_pattern.(analysis_run_id, user_id) > analysis_run.(id, user_id)
Ref: pattern_evidence.(personal_pattern_id, user_id) > personal_pattern.(id, user_id)
Ref: pattern_evidence.(experience_record_id, user_id) > experience_record.(id, user_id)
Ref: pattern_feedback.(personal_pattern_id, user_id) > personal_pattern.(id, user_id)

Ref: rescue_case.(start_routine_version_id, user_id) > routine_version.(id, user_id)
Ref: rescue_case.(source_experience_record_id, user_id) > experience_record.(id, user_id)
Ref: rescue_case.(comparison_baseline_routine_version_id, user_id) > routine_version.(id, user_id)
Ref: rescue_message.(rescue_case_id, user_id) > rescue_case.(id, user_id)
Ref: rescue_safety_event.(rescue_case_id, user_id) > rescue_case.(id, user_id)
Ref: rescue_safety_event.(source_message_id, user_id, rescue_case_id) > rescue_message.(id, user_id, rescue_case_id)
Ref: rescue_plan.(rescue_case_id, user_id) > rescue_case.(id, user_id)
Ref: rescue_plan.(analysis_run_id, user_id) > analysis_run.(id, user_id)
Ref: rescue_plan.(base_routine_version_id, user_id) > routine_version.(id, user_id)
Ref: rescue_plan.(applied_routine_version_id, user_id) > routine_version.(id, user_id)
Ref: rescue_change.(rescue_plan_id, user_id) > rescue_plan.(id, user_id)
Ref: rescue_change.(user_product_id, user_id) > user_product.(id, user_id)
Ref: routine_version.(source_rescue_plan_id, user_id) > rescue_plan.(id, user_id)

Ref: analysis_run.(analysis_request_id, user_id) > analysis_request.(id, user_id)
Ref: analysis_request.(selected_run_id, user_id, id) > analysis_run.(id, user_id, analysis_request_id)
Ref: conversation.(root_analysis_request_id, user_id) > analysis_request.(id, user_id)
Ref: conversation_message.(conversation_id, user_id) > conversation.(id, user_id)
Ref: conversation_message.(analysis_run_id, user_id) > analysis_run.(id, user_id)
Ref: ai_memory.(source_conversation_message_id, user_id) > conversation_message.(id, user_id)
Ref: ai_memory.(created_by_analysis_run_id, user_id) > analysis_run.(id, user_id)
Ref: rescue_message.(analysis_run_id, user_id) > analysis_run.(id, user_id)
Ref: analysis_evidence.(analysis_run_id, user_id) > analysis_run.(id, user_id)
Ref: analysis_evidence.(experience_record_id, user_id) > experience_record.(id, user_id)
Ref: analysis_evidence.(personal_pattern_id, user_id) > personal_pattern.(id, user_id)
Ref: analysis_evidence.(rescue_case_id, user_id) > rescue_case.(id, user_id)
Ref: analysis_evidence.(ai_memory_id, user_id) > ai_memory.(id, user_id)

Ref: ai_job.(analysis_request_id, user_id) > analysis_request.(id, user_id)
Ref: ai_job.(analysis_run_id, user_id) > analysis_run.(id, user_id)
Ref: ai_job.(retry_of_job_id, user_id) > ai_job.(id, user_id)

Ref: notification.(experience_review_schedule_id, user_id) > experience_review_schedule.(id, user_id)
Ref: notification.(ai_job_id, user_id) > ai_job.(id, user_id)

Ref: receipt_upload.(ai_job_id, user_id) > ai_job.(id, user_id)
Ref: receipt_item.(receipt_upload_id, user_id) > receipt_upload.(id, user_id)
Ref: receipt_item.(created_user_product_id, user_id, confirmed_product_version_id) > user_product.(id, user_id, product_version_id)
Ref: catalog_review_request.(user_product_id, user_id) > user_product.(id, user_id)
Ref: catalog_review_request.(receipt_item_id, user_id) > receipt_item.(id, user_id)
